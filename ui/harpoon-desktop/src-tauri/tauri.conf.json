{
  "productName": "Harpoon",
  "version": "2.0.0-rc.2",
  "identifier": "com.harpoon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Harpoon",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle-resources/harpoon": "harpoon"
    },
    "macOS": {
      "entitlements": null,
      "frameworks": [],
      "signingIdentity": null,
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
